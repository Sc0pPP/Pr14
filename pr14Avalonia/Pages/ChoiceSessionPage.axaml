<nav:Page xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:nav="clr-namespace:WpfLikeAvaloniaNavigation;assembly=WpfLikeAvaloniaNavigation"
             xmlns:pr14Avalonia="clr-namespace:pr14Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             
             x:Class="pr14Avalonia.Pages.ChoiceSessionPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="25"/>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Content="Назад" HorizontalAlignment="Right" Margin="10" Click="Button_OnClick"/>
        <TextBlock Grid.Row="0" Text="Выбор Мест" HorizontalAlignment="Center" Margin="20"/>
        <Border Grid.Row="1" Height="40" Margin="80,20" Background="#E0E0E0" CornerRadius="6">
            <TextBlock Text="ЭКРАН" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
        </Border>
        <Grid Grid.Row="2">
            <ScrollViewer>
                <UniformGrid x:Name="SeatsPanel"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"/>
            </ScrollViewer>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock x:Name="PriceBox" Margin="20,0,20,20"/>
            <Button Content="Купить" Margin="20,0,20,0" Click="Button_OnClick1"/>
        </StackPanel>
        </Grid>
</nav:Page>
